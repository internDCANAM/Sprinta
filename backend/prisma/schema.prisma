generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN @map("en")
  SV @map("sv")
}

enum DealType {
  REGENERATION_FELLING
  THINNING
  ENERGY_WOOD
  MISC
}

enum DealStatus {
  PLANNED
  ONGOING
  COMPLETED
  INVOICED
  CLOSED
}

enum DealEventType {
  DEAL_SIGNED
  HARVEST_STARTED
  HARVEST_COMPLETE
  MEASUREMENT_REPORT
  PAYMENT_DISBURSEMENT
  MISC
}

enum DocumentType {
  CONTRACT
  SETTLEMENT
  MEASUREMENT_REPORT
  STANFORD
  MISC
}

enum PaymentStatus {
  PLANNED
  COMPLETED
  FAILED
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  isAdmin      Boolean  @default(false) @map("is_admin")
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addressStreet        String?   @map("address_street")
  addressPostal        String?   @map("address_postal")
  addressCity          String?   @map("address_city")
  phone                String?
  bankAccountMasked    String?   @map("bank_account_masked")
  bankAccountEncrypted String?   @map("bank_account_encrypted")
  bankAccountUpdatedAt DateTime? @map("bank_account_updated_at")

  properties Property[]
  deals      Deal[]     @relation("OwnerDeals")
  documents  Document[] @relation("OwnerDocuments")

  assignedDeals Deal[]      @relation("AssignedTo")
  createdEvents DealEvent[]
  uploadedDocs  Document[]  @relation("DocumentUploader")
  sentMessages  Message[]
  auditEntries  AuditLog[]

  @@map("users")
}

model Property {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  name         String
  cadastralId  String   @map("cadastral_id")
  municipality String
  areaHa       Decimal  @map("area_ha") @db.Decimal(10, 2)
  geojson      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deals Deal[]

  @@index([ownerId])
  @@map("properties")
}

model Deal {
  id                  String     @id @default(uuid()) @db.Uuid
  ownerId             String     @map("owner_id") @db.Uuid
  propertyId          String?    @map("property_id") @db.Uuid
  externalId          String     @unique @map("external_id")
  title               String
  dealType            DealType   @map("deal_type")
  status              DealStatus
  estimatedGrossMinor BigInt?    @map("estimated_gross_minor")
  finalGrossMinor     BigInt?    @map("final_gross_minor")
  assignedToId        String?    @map("assigned_to_id") @db.Uuid
  syncedAt            DateTime?  @map("synced_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  owner       User         @relation("OwnerDeals", fields: [ownerId], references: [id], onDelete: Restrict)
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  events      DealEvent[]
  timberPosts TimberPost[]
  costs       DealCost[]
  documents   Document[]
  messages    Message[]
  payments    Payment[]

  @@index([ownerId])
  @@index([propertyId])
  @@index([status])
  @@map("deals")
}

model DealEvent {
  id          String        @id @default(uuid()) @db.Uuid
  dealId      String        @map("deal_id") @db.Uuid
  eventType   DealEventType @map("event_type")
  label       String
  plannedDate DateTime?     @map("planned_date")
  actualDate  DateTime?     @map("actual_date")
  note        String?
  createdBy   String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  deal    Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@map("deal_events")
}

model TimberPost {
  id                String   @id @default(uuid()) @db.Uuid
  dealId            String   @map("deal_id") @db.Uuid
  assortment        String
  volumeM3          Decimal  @map("volume_m3") @db.Decimal(12, 3)
  pricePerM3Minor   BigInt   @map("price_per_m3_minor")
  grossMinor        BigInt   @map("gross_minor")
  measurementSource String?  @map("measurement_source")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("timber_posts")
}

model DealCost {
  id          String   @id @default(uuid()) @db.Uuid
  dealId      String   @map("deal_id") @db.Uuid
  costType    String   @map("cost_type")
  amountMinor BigInt   @map("amount_minor")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_costs")
}

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  dealId     String?      @map("deal_id") @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  docType    DocumentType @map("doc_type")
  filename   String
  storageKey String       @map("storage_key")
  mimeType   String       @map("mime_type")
  sizeBytes  Int          @map("size_bytes")
  uploadedBy String       @map("uploaded_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")

  deal     Deal? @relation(fields: [dealId], references: [id], onDelete: Restrict)
  owner    User  @relation("OwnerDocuments", fields: [ownerId], references: [id], onDelete: Restrict)
  uploader User  @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@index([ownerId])
  @@map("documents")
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  dealId    String    @map("deal_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@map("messages")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  dealId            String        @map("deal_id") @db.Uuid
  amountMinor       BigInt        @map("amount_minor")
  paymentDate       DateTime      @map("payment_date")
  status            PaymentStatus
  reference         String?
  bankAccountMasked String        @map("bank_account_masked")
  externalPaymentId String?       @map("external_payment_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([dealId])
  @@index([status])
  @@map("payments")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tableName    String   @map("table_name")
  recordId     String   @map("record_id") @db.Uuid
  changedBy    String   @map("changed_by") @db.Uuid
  fieldName    String   @map("field_name")
  oldValueHash String?  @map("old_value_hash")
  newValueHash String?  @map("new_value_hash")
  ipAddress    String   @map("ip_address")
  userAgent    String   @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([tableName, recordId])
  @@index([changedBy])
  @@map("audit_log")
}

model SecurityEvent {
  id        String                @id @default(uuid()) @db.Uuid
  eventType String                @map("event_type")
  severity  SecurityEventSeverity
  userId    String?               @map("user_id") @db.Uuid
  ipAddress String                @map("ip_address")
  userAgent String?               @map("user_agent")
  path      String?
  method    String?
  message   String
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}
