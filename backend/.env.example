# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://sprintaiso:sprintaiso_dev@localhost:5432/sprintaiso?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3

# JWT / CSRF / ENCRYPTION_KEY — filled by `pnpm env:secrets`
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-different-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CSRF_SECRET=replace-with-another-32-byte-random-string
ENCRYPTION_KEY=replace-with-64-hex-chars-representing-32-bytes

# Object storage (Cloudflare R2 — mocked with local dir for now)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# CORS
CORS_ORIGIN=http://localhost:5173
